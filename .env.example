# Copy to .env for local development. docker-compose.yml serves these defaults.
DATABASE_URL=postgres://apion:apion@localhost:5432/apion

# Sign JWTs with a value from `openssl rand -base64 48`. The example is not a
# usable secret; the API refuses to start with it in production.
JWT_SECRET=development-only-change-me
JWT_TTL_SECONDS=43200

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Where the built SPA is served from. Empty in development, where Vite serves it.
WEB_DIST_PATH=

SMTP_HOST=localhost
SMTP_PORT=1025
