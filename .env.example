# Copy to .env for local development. docker-compose.yml serves these defaults.
DATABASE_URL=postgres://apion:apion@localhost:5432/apion

# Sign JWTs with a value from `openssl rand -base64 48`. The example is not a
# usable secret; the API refuses to start with it in production.
JWT_SECRET=development-only-change-me
JWT_TTL_SECONDS=43200

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Where the built SPA is served from. Empty in development, where Vite serves it.
WEB_DIST_PATH=

SMTP_HOST=localhost
SMTP_PORT=1025

# --- Production only ---------------------------------------------------------
# The VPS keeps its own .env next to docker-compose.prod.yml. These are the keys
# that file needs; the deploy workflow writes APION_IMAGE into it and touches
# nothing else.
#
# Required: POSTGRES_PASSWORD, and a JWT_SECRET that is not the example above.
# docker-compose.prod.yml builds DATABASE_URL from the POSTGRES_* values, so the
# development DATABASE_URL at the top of this file is ignored there.
#POSTGRES_USER=apion
#POSTGRES_PASSWORD=
#POSTGRES_DB=apion

# Published on loopback only; put a TLS-terminating reverse proxy in front.
#APION_PORT=3000

# Written by the deploy. Set it by hand to roll back to an earlier commit's tag.
#APION_IMAGE=ghcr.io/<owner>/<repo>:<sha>
