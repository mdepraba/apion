# Copy to .env for local development. docker-compose.yml serves these defaults.
DATABASE_URL=postgres://apion:apion@localhost:5432/apion

# Sign JWTs with a value from `openssl rand -base64 48`. The example is not a
# usable secret; the API refuses to start with it in production.
JWT_SECRET=development-only-change-me
JWT_TTL_SECONDS=43200

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Where the built SPA is served from. Empty in development, where Vite serves it.
WEB_DIST_PATH=

SMTP_HOST=localhost
SMTP_PORT=1025

# --- Production only ---------------------------------------------------------
# The VPS keeps its own /srv/apion/.env. The systemd unit reads it as an
# EnvironmentFile and the deploy sources it to run migrations, so every value
# has to be a plain KEY=VALUE with no quotes, spaces or shell expansion.
#
# The deploy never writes this file. Required: DATABASE_URL, and a JWT_SECRET
# that is not the example above.
#DATABASE_URL=postgres://apion:PASSWORD@127.0.0.1:5432/apion
#JWT_SECRET=
#LOG_LEVEL=info

# The API listens on loopback; put a TLS-terminating reverse proxy in front.
#PORT=3000

# WEB_DIST_PATH and MIGRATIONS_FOLDER are set by the unit itself, because they
# point into the release directory the deploy just swapped in.
