{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "libs/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "argon2",
    "esbuild",
    "unrs-resolver"
  ],
  "scripts": {
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "format": "nx run-many -t format",
    "check": "nx run-many -t check",
    "boundaries": "bun tools/boundaries/check-boundaries.mjs",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "db:generate": "drizzle-kit generate --config=libs/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=libs/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=libs/db/drizzle.config.ts",
    "db:seed": "nx run @apion/api:seed && bun apps/api/dist-seed/seed.js",
    "dev:api": "nx run @apion/api:serve",
    "dev:web": "nx run @apion/web:dev"
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.3",
    "@nx/devkit": "23.2.0",
    "@nx/esbuild": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/nest": "23.2.0",
    "@nx/node": "23.2.0",
    "@nx/react": "23.2.0",
    "@nx/vite": "23.2.0",
    "@nx/vitest": "23.2.0",
    "@nx/web": "23.2.0",
    "@nx/webpack": "23.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.37",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "drizzle-kit": "^0.31.10",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "nx": "23.2.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "~4.1.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "ajv": "^8.20.0",
