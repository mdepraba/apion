{
  "name": "@apion/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/package.json",
          {
            "runtime": "bun --version"
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "parallel": true,
          "cwd": "{workspaceRoot}"
        },
        "configurations": {
          "development": {
            "commands": [
              "nx run @apion/api:build:development --watch",
              "bun --watch --smol apps/api/dist/main.js"
            ]
          },
          "production": {
            "commands": [
              "bun --smol apps/api/dist/main.js"
            ]
          }
        }
      },
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "defaultConfiguration": "development",
        "outputs": [
          "{options.outputPath}"
        ],
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "options": {
          "platform": "node",
          "format": [
            "esm"
          ],
          "outputPath": "apps/api/dist",
          "main": "apps/api/src/main.ts",
          "tsConfig": "apps/api/tsconfig.app.json",
          "assets": [],
          "bundle": true,
          "thirdParty": false,
          "esbuildConfig": "apps/api/esbuild.config.cjs"
        },
        "configurations": {
          "development": {
            "minify": false
          },
          "production": {
            "minify": true
          }
        }
      },
      "seed": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "platform": "node",
          "format": [
            "esm"
          ],
          "outputPath": "apps/api/dist-seed",
          "main": "apps/api/src/cli/seed.ts",
          "tsConfig": "apps/api/tsconfig.app.json",
          "bundle": true,
          "thirdParty": false,
          "assets": [],
          "esbuildConfig": "apps/api/esbuild.config.cjs"
        }
      },
      "migrate": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "platform": "node",
          "format": [
            "esm"
          ],
          "outputPath": "apps/api/dist-migrate",
          "main": "apps/api/src/cli/migrate.ts",
          "tsConfig": "apps/api/tsconfig.app.json",
          "bundle": true,
          "thirdParty": false,
          "assets": [],
          "esbuildConfig": "apps/api/esbuild.config.cjs"
        }
      }
    },
    "tags": [
      "type:app",
      "scope:api"
    ]
  },
  "dependencies": {
    "@apion/contracts": "workspace:*",
    "@apion/db": "workspace:*",
    "@apion/domain": "workspace:*",
    "@apion/mock-engine": "workspace:*",
    "@apion/response-standard": "workspace:*",
    "@apion/spec-openapi": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  },
  "type": "module"
}
